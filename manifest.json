{
  "manifest_version": 3,
  "name": "honto Library Extension",
  "version": "1.0",
  "description": "hontoウィッシュリストの本が図書館にあるか確認",
  "permissions": ["storage"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://honto.jp/my/wishlist*"],
    "js": ["content.js"],
    "css": ["style.css"]
  }],
  "options_page": "options.html",
  "host_permissions": ["https://api.calil.jp/*", "https://honto.jp/*"]
}
